# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used by scripts/seed-demo.ts — never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — server only. Without a key the app falls back to deterministic
# mapping and data-driven summaries (and tells the user AI is unavailable).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
